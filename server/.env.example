# ───────────────────────────────────────────────
# FitCore v2 (Node) — Environment Variables Template
# Copy this file to .env and fill in your values.
# NEVER commit the actual .env file to git.
# ───────────────────────────────────────────────

# ─── Application ──────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=debug
PORT=8000

# ─── MongoDB ──────────────────────────────────
# Local:   mongodb://localhost:27017
# Atlas:   mongodb+srv://<user>:<pass>@cluster.mongodb.net
MONGODB_URI=mongodb://localhost:27017
DATABASE_NAME=fitcore_db

# ─── JWT Auth ─────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=your-super-secret-key-change-this-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# ─── Razorpay ─────────────────────────────────
# Leave these placeholders to keep the gateway mocked: orders get a synthetic
# id and signatures are not verified. Real keys switch both on.
# Get from: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# ─── CORS ─────────────────────────────────────
# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000

# ─── Brevo (transactional email) ──────────────
# Password-reset codes are emailed through Brevo's HTTP API. Without a key the
# server still starts, but no reset code can be delivered.
# The sender address must be a verified sender in your Brevo account, and the
# calling server's IP must be allowed under Security → Authorised IPs.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=no-reply@fitcore.app
BREVO_SENDER_NAME=FitCore
