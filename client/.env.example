# ── API ──────────────────────────────────────────────────────────────────
# Where the backend lives, including the /api/v1 prefix.
#
# Development: leave this unset. The Vite dev server proxies /api to
# http://localhost:8000, so no value is needed.
#
# Production: REQUIRED. The build bakes this into the bundle and refuses to
# build without it, since a deployed site cannot fall back to localhost.
# VITE_API_BASE_URL=https://your-api.onrender.com/api/v1

# ── Referral links ───────────────────────────────────────────────────────
# Public site URL used to build referral links. Leave unset to use whatever
# origin the app is served from (localhost in dev, your domain in production).
# Set it only if the public site lives on a different host than this app.
# VITE_PUBLIC_SITE_URL=https://fitcore.in
